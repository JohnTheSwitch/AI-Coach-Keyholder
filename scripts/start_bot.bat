@echo off
rem Generated by scripts/make_start_script.py -- regenerate it instead of editing (absolute paths for this machine).
rem Starts the AI Coach and Keyholder Discord bot from the repository directory (it reads .env there), appends all output
rem to logs\bot.log and restarts it after a crash: wait 10 s, at most 3 restarts.
setlocal
title AI Coach Keyholder bot
cd /d "C:\Users\jirka\claude\AI-Coach-Keyholder" || exit /b 1
if not exist logs mkdir logs
set RESTARTS=0
:run
>> "logs\bot.log" echo [%date% %time%] start_bot.bat: starting the bot, restarts so far %RESTARTS%
"C:\Users\jirka\AppData\Local\Python\pythoncore-3.14-64\python.exe" -m bot.discord_bot >> "logs\bot.log" 2>&1
set CODE=%ERRORLEVEL%
>> "logs\bot.log" echo [%date% %time%] start_bot.bat: the bot exited with code %CODE%
if "%CODE%"=="0" goto done
if %RESTARTS% GEQ 3 goto giveup
set /a RESTARTS+=1
>> "logs\bot.log" echo [%date% %time%] start_bot.bat: restarting in 10 seconds, restart %RESTARTS% of 3
ping -n 11 127.0.0.1 >nul
goto run
:giveup
>> "logs\bot.log" echo [%date% %time%] start_bot.bat: giving up after 3 restarts
:done
endlocal & exit /b %CODE%
