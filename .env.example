# Copy this file to .env and fill in real values.
# NEVER commit .env to git (see .gitignore).

# --- Discord ---------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_COMMAND_PREFIX=!

# --- Ollama ------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_READ_TIMEOUT_SECONDS=30
# Keep the model loaded between messages (e.g. 30m); empty = Ollama's default.
OLLAMA_KEEP_ALIVE=
# Phase F1: ask the model for JSON (reply + optional side data that has no effect yet). Default false.
CONVERSATION_STRUCTURED_OUTPUT=false
# Phase F2: Coaching Memory (the coach may save short notes about your own patterns, goals and quotes; `memory` / `forget`).
# Needs CONVERSATION_STRUCTURED_OUTPUT=true. Default false.
ENABLE_COACHING_MEMORY=false
OLLAMA_MODEL=llama3.1

# --- Database ----------------------------------------------------------------
# Leave blank for the default (data/coach_keyholder.db at the project root)
DB_PATH=

# How many recent automatic backups to keep (rotation policy).
# Backups are created: at most once a day at startup + always before applying a migration.
BACKUP_RETENTION_COUNT=14

# --- Integrations (Phase 7 — optional for now) -------------------------------------
CHASTER_API_TOKEN=
APPLE_HEALTH_API_KEY=

# --- CHASTER-01A: OAuth connection foundation (all optional -- the bot -----------
# starts normally and simply does not offer `chaster connect` if any of these
# is unset). See docs/architecture/chaster_integration_technical_design.md.
#
# Non-secrets:
# Scopes requested by `chaster connect` (space-separated). Connect the bot's KEYHOLDER account with "locks keyholder"
# (add "messaging" for Chaster chat) so it can list managed locks; wearers need only "locks".
CHASTER_OAUTH_SCOPES=locks
CHASTER_CLIENT_ID=
CHASTER_REDIRECT_URI=
CHASTER_CALLBACK_BIND_HOST=127.0.0.1
CHASTER_CALLBACK_BIND_PORT=8420
#
# Secrets -- never commit a real value here. CHASTER_TOKEN_ENCRYPTION_KEY must
# be generated once, by you, and then backed up SEPARATELY from the database
# (database/ backups do not include this file) -- losing one without the
# other makes every stored Chaster connection permanently undecryptable:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHASTER_CLIENT_SECRET=
CHASTER_TOKEN_ENCRYPTION_KEY=

# --- PC-local Chaster emergency-unlock safety plane (all optional -- the ------
# emergency server, a SEPARATE standalone process, simply refuses to start
# without this secret; it is never wired into the Discord bot process). See
# docs/architecture/chaster_integration_technical_design.md Section 25c.
CHASTER_EMERGENCY_BIND_HOST=127.0.0.1
CHASTER_EMERGENCY_BIND_PORT=8421
# A dedicated, SEPARATE secret -- never reuse CHASTER_CLIENT_SECRET or
# CHASTER_TOKEN_ENCRYPTION_KEY here:
CHASTER_EMERGENCY_UNLOCK_SECRET=

# --- General --------------------------------------------------------------------
LOG_LEVEL=INFO
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00

# v0.39 scheduling windows. Local-time rules use APP_TIMEZONE (IANA name). QUIET_HOURS_* above
# are interpreted in that zone. Weekdays (Mon-Fri, excluding public holidays of HOLIDAY_COUNTRY)
# are "work" time from QUIET_HOURS_END until WORKDAY_END: no unlock. Evenings and
# weekends/holidays (outside quiet hours) are the discretionary release window.
APP_TIMEZONE=Europe/Prague
WORKDAY_START=07:00
WORKDAY_END=16:30
HOLIDAY_COUNTRY=CZ
# On weekends and public holidays the release base is this time (WORKDAY_END has no meaning there).
WEEKEND_RELEASE_START=10:00
# Adaptive release target = WORKDAY_END + a pseudorandom offset (minutes) in this range.
UNLOCK_WINDOW_MIN_OFFSET_MINUTES=30
UNLOCK_WINDOW_MAX_OFFSET_MINUTES=210
# Safety backstop: a barrier held longer than this is released at the next valid window.
MAX_BARRIER_HOLD_HOURS=72
# Proactive supervision state (consumes trust recalculations). Default false.
ENABLE_SUPERVISION=false
# Periodic Single Barrier release tick (plans a secret release time, spends one token, lowers the
# barrier through the execution plane). Needs ENABLE_RULES_ENGINE and the Chaster settings; it only
# spends tokens when ENABLE_CHASTER_EXECUTION is also true. Default false.
ENABLE_RELEASE_ENGINE=false
# Proactive Discord check-ins (never in quiet or work hours). Needs the two settings below. Default false.
ENABLE_CHECK_INS=false
CHECK_IN_TRUST_DOMAIN=routine
# Check-in deadlines in minutes. Strict Supervision Mode (Trust < 0.40) uses the strict values.
CHECKIN_RESPONSE_TIMEOUT_MINUTES=60
CHECKIN_FOLLOW_UP_MINUTES=30
CHECKIN_STRICT_RESPONSE_TIMEOUT_MINUTES=30
CHECKIN_STRICT_FOLLOW_UP_MINUTES=15
CHECK_IN_USER_ID=
# Daily evaluation (runs with ENABLE_RELEASE_ENGINE at local midnight): token pool + clean-day streak.
DAILY_EVALUATION_TRUST_DOMAIN=routine
# Chaster chat channel (default false). The bot (keyholder) account must be connected with the "messaging" scope
# (CHASTER_OAUTH_SCOPES="locks keyholder messaging"); each user opts in with the `channel chaster` command.
ENABLE_CHASTER_MESSAGING=false
# Internal user id of the owner. `python -m cli freeze-lock` refuses anyone else (and refuses everything while this is empty).
OWNER_USER_ID=
# Multi-wearer (v0.39 Phase E, default off): a platform database with the tenant registry; the existing system becomes tenant_0.
ENABLE_MULTI_WEARER=false
PLATFORM_DB_PATH=
TENANT_CAP=5
# Shared request budget of the keyholder account per minute (lock searches, observation refreshes, chat polling).
# An already-decided lock action is never refused by it, only counted.
CHASTER_API_BUDGET_PER_MINUTE=30
CHASTER_CHAT_POLL_SECONDS=30

# --- Chaster LLM tool (read-only) -------------------------------------------------
# When true (and Chaster is fully configured), the conversation model may call a
# read-only `get_chaster_status` tool for questions like "how much time is left?".
# Requires an Ollama model with tool-calling support; if the model rejects tools
# the bot falls back to ordinary replies. Default: false.
CHASTER_LLM_TOOLS_ENABLED=false

# Rules Engine (Phase 2). STRICT DRY RUN: records auditable decisions about lock
# time changes but never calls Chaster. Default: false.
ENABLE_RULES_ENGINE=false

# Chaster execution plane (Phase 3). Master switch, default false. When true it can
# apply add_time / remove_time decisions to the lock -- but only if a real transport
# is available, both identities below are set, and the local runtime halt
# (scripts/execution_control.py) has been cleared. Freeze/unfreeze never execute.
ENABLE_CHASTER_EXECUTION=false
# Internal user ids (NOT Chaster ids): the wearer whose lock is observed, and the user
# whose Chaster OAuth connection holds the keyholder role.
CHASTER_EXECUTION_WEARER_USER_ID=
CHASTER_EXECUTION_KEYHOLDER_USER_ID=
CHASTER_EXECUTION_INTERVAL_SECONDS=60
